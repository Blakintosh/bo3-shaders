// Shared body of blak_frosted_glass (viewmodel) and blak_frosted_glass_world (world geometry and models): the
// textures, constants and techniques. The two differ only in their Globals (render flags and prefixes): see them.

//----------------------------------------------------------------

Texture( "normalMap" )
{
	image = Image( <normalMap, $identitynormalmap> )
	semantic = "normalMap"
	usage = "normal map"
	tweak = Tweak()
	{
		category  = "Surface"
		title     = "Normal Map"
		sortindex = "1"
	}
}

