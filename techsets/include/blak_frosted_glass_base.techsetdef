Color( "glassTint" )
{
	value = "srgb_to_linear( <colorTint3> )"
	tweak = Tweak()
	{
		category  = "Transmission"
		title     = "Transmission Tint"
		sortindex = "12"
	}
}

//----------------------------------------------------------------

Technique( "lit" )
{
	state = State() : "blend"
	{
		depthTest  = lessEqual
		depthWrite = false
	}
	source = "blak/blak_frosted_glass.hlsl"
	vs = VertexShader() {}
	ps = PixelShader()
	{
#if TOOLSGFX != "1"
		iResolveScene = CodeTexture( "resolvedPostSun" )
		// the lit passes' shared samplers, for the probe lighting (blak_lighting.h)
		samplerLinear = Sampler( "tile both", "mip (1x trilinear)", true )
		samplerLinearClamp = Sampler( "no tile", "mip (1x trilinear)", true )
#endif
		materialSampler = Sampler( "tile both", "mip (1x trilinear)" )
		sceneSampler = Sampler( "no tile", "mip (1x trilinear)" )
	}
}

#if TOOLSGFX == "1"
Technique( "oit" ) : "lit"
{
	state = "fallback + depth + rez"
	defines += "USE_OIT"
}
#endif
