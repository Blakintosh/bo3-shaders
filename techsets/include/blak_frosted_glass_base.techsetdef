// Constants: one editable field each (a Tweak with a default and range, so a new material works as created).
// They map to the material's cg01..cg04 values, which existing materials keep.

float1( "blurRadius" )
{
	x     = <cg01_x>
	tweak = Tweak()
	{
		category  = "Frost"
		title     = "Blur Radius (px at 1080p, 0 = clear)"
		sortindex = "21"
		default   = "12"
		range     = "0.0", "128.0", "0.1"
	}
}

float1( "thicknessToBlur" )
