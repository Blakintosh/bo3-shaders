// Two-layer blend with hardware tessellation, displacement and parallax: layer 2 comes in by vertex alpha (paint it
// down from 1) and the layers' heights (blak/tess_blend.h). Otherwise as lit_advanced_fullspec_parallax_tess. Controls,
// modes and the linker requirement: include/blak_tess_base.techsetdef and blak/blak_tess_common.hlsl.
// The shadow pass is tessellated and displaced the same way (blak/blak_shadow_tess.hlsl).

#include "lit_base_mid"
#include "blak_parallax_base"
#include "blak_tess_base"

Globals()
{
	category = "Geometry Advanced"
	renderFlags = "lit deferred opaque"
	availablePrefixes = "mc/ mcs/ wc/"
}

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

Texture( "specColorMap" )
{
	image = Image( <specColorMap, $specular> )
	semantic = "specularMap"
	tweak = Tweak()
	{
		category  = "Specular and Gloss"
		title     = "Specular Map"
		sortindex = "20"
	}
}

Texture( "colorMap2" )
{
	image = Image( <colorMap09, $white_diffuse> )
	semantic = "diffuseMap"
	tweak = Tweak( "Layer 2", "Color Map", "10" )
}

Texture( "normalMap2" )
{
	image = Image( <colorMap10, $identitynormalmap> )
	semantic = "normalMap"
	tweak = Tweak( "Layer 2", "Normal Map", "20" )
}

Texture( "specColorMap2" )
{
	image = Image( <colorMap11, $specular> )
	semantic = "specularMap"
	tweak = Tweak( "Layer 2", "Specular Map", "30" )
}

Texture( "glossMap2" )
{
	image = Image( <colorMap12, $white_gloss> )
	semantic = "glossMap"
	tweak = Tweak( "Layer 2", "Gloss Map", "40" )
}

Texture( "heightMap2" )
{
	image = Image( <colorMap13, $white_reveal> )
	semantic = "revealMap"
	tweak = Tweak( "Layer 2", "Height Map", "50" )
}

float1( "tessBlendContrast" )
{
	x = <cg12_x>
	tweak = Tweak()
	{
		category  = "Layer 2"
		title     = "Blend Softness (0 = 0.2)"
		sortindex = "60"
	}
}

float1( "tessLayer2Height" )
{
	x = <cg12_y>
	tweak = Tweak()
	{
		category  = "Layer 2"
		title     = "Height Strength (0 = flat, 1 = as authored)"
		sortindex = "70"
	}
}

DomainShader( "ds_tess_blend" )
{
	source = "blak/blak_gbuffer_tess_lit_blend.hlsl"
}

DomainShader( "ds_tess_shadow" )
{
	source = "blak/blak_shadow_tess.hlsl"
	defines = "TESS_HEIGHT_BLEND"
}

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

Technique( "build shadowmap depth" )
{
	state = "buildShadowmap"
	ls = LocalShader() : "ls_tess" {}
	hs = HullShader() : "hs_tess" {}
	ds = DomainShader() : "ds_tess_shadow" {}
	ps = PixelShader()
	{
		source = "blak/blak_shadow_tess.hlsl"
		defines = "TESS_HEIGHT_BLEND"
	}
}

#if TETRAHEDRON_OMNI_SHADOWS=="1"
Technique( "build shadowmap depth planes" ) : "build shadowmap depth planes base"
{}
#endif

Technique( "build shadowmap depth layered" ) :  "build shadowmap depth layered base"
{}

Technique( "unlit" )
{
	state = "replace + depth"
	defines = "USE_COLOR_TINT"
	source = "techsetdef_unlit_simple.hlsl"
	vs = "vs_generic"
	ps = "ps_generic"
}

Technique( "gbuffer" )
{
	state = "gbuffer opaque"
	defines = "USE_COLOR_SPEC", "USE_COLOR_TINT"
	ls = LocalShader() : "ls_tess" {}
	hs = HullShader() : "hs_tess" {}
	ds = DomainShader() : "ds_tess_blend" {}
	ps = PixelShader() : "ps_generic"
	{
		source = "blak/blak_gbuffer_ps_lit_blend.hlsl"
	}
}

Technique( "gbuffer motion vector" ) : "gbuffer"
{
	defines += "GENERATE_MOTION_VECTOR"
}

Technique( "debug color texel" )
{
	state = "replace + depth"
	source = "ToolsGfx/debug_texeldensity.hlsl"
	vs = "vs_generic"
	ps = PixelShader() : "ps_generic"
	{
		defines = "DEBUG_COLOR_TEXELS"
	}
}
